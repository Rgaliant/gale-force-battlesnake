modules = ["go-1.24"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd gosnake && go build -o /tmp/gosnake . && PORT=5000 /tmp/gosnake"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

# The deployment build and run steps execute in separate environments -
# only the project directory carries over, so the binary must be built
# into the project tree, never /tmp.
[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "cd gosnake && go build -o ../snake-server ."]

[deployment.run]
args = ["sh", "-c", "./snake-server"]
