modules = ["go-1.24"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd gosnake && go build -o /tmp/gosnake . && PORT=5000 /tmp/gosnake"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "cd gosnake && go build -o /tmp/gosnake ."]

[deployment.run]
args = ["sh", "-c", "/tmp/gosnake"]
