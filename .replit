modules = ["go-1.24"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd gosnake && go build -o /tmp/gosnake . && PORT=5000 /tmp/gosnake"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

# The deployment pipeline proved unwilling to run a build step (logs
# show it jumping straight to the run command), so the repo ships
# prebuilt static Linux binaries in bin/ and the run command just picks
# one by architecture - nothing to compile at deploy time. Rebuild them
# after engine changes:
#   cd gosnake && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o ../bin/snake-linux-amd64 .
#   cd gosnake && CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -o ../bin/snake-linux-arm64 .
[deployment]
deploymentTarget = "cloudrun"

[deployment.run]
args = ["sh", "-c", "PORT=\"${PORT:-5000}\"; export PORT; case \"$(uname -m)\" in x86_64) exec bin/snake-linux-amd64;; aarch64|arm64) exec bin/snake-linux-arm64;; *) echo \"unsupported arch $(uname -m)\" >&2; exit 1;; esac"]
